{
	"name": "pi-cc-loop",
	"version": "0.7.4",
	"description": "Claude Code compatible /loop for the Pi coding agent: cron-scheduled fixed intervals, self-paced chains, and the same dispatch semantics as Claude Code.",
	"author": "tarnish233",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"extension",
		"loop",
		"cron",
		"scheduler",
		"claude-code"
	],
	"homepage": "https://github.com/tarnish233/pi-cc-loop#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tarnish233/pi-cc-loop.git"
	},
	"bugs": {
		"url": "https://github.com/tarnish233/pi-cc-loop/issues"
	},
	"files": [
		"*.ts",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"publishConfig": {
		"access": "public"
	}
}
